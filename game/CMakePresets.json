{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug, default generator",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FCT_WERROR": "ON"
      }
    },
    {
      "name": "dev-ninja",
      "inherits": "dev",
      "displayName": "Debug, Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-ninja"
    },
    {
      "name": "release",
      "inherits": "dev",
      "displayName": "RelWithDebInfo",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "dev-ninja", "configurePreset": "dev-ninja" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-ninja",
      "configurePreset": "dev-ninja",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    }
  ]
}
